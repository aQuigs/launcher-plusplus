<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only the instrumented badge test posts notifications, from the app itself, for the listener to count. It is
         never requested at runtime, so the debug build stays as quiet as the release build unless a test grants it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

</manifest>
