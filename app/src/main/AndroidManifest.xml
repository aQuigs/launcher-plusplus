<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Without it, the system ignores the uninstall request from an app's menu. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- The stock clock app guards the alarms screen, which the home clock opens, with this normal permission. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- A swipe down on the home page pulls the notification shade down with it. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Lists the launcher on the system's Do Not Disturb access screen, where the user grants the access the ringer switch
         needs. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Usage access for the Most Used card. The system grants it through its own settings screen, never at runtime,
         which is why lint's warning about a protected permission does not apply. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Firebase Analytics asks for the advertising ID and the Privacy Sandbox's ad attribution, which usage counts do not
         need and Play would make us declare. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Orbit">

        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />

        <!-- The ring, the dock and the pages are laid out for a tall screen, as Arc's are; sideways, the ring shrinks to a
             thumbnail and the dock stretches across the screen. Android 16 ignores the lock on screens 600dp and wider,
             so a tablet still turns; a phone does not. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Not exported: MainActivity takes a pin request only through it, so no other app can hand the home screen one. -->
        <activity-alias
            android:name=".PinRequests"
            android:exported="false"
            android:targetActivity=".MainActivity" />

        <!-- The system starts it, and it alone may, whenever another app asks to pin a shortcut to the home screen, so
             that apps, Chrome's install among them, offer to. It has no window, task or place in recents of its own. -->
        <activity
            android:name=".PinShortcutActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>

        <!-- Only the launcher starts it, to open a pair of apps in split screen. It stays until the second app is started,
             so it is see-through rather than without display, and keeps its history, which would end it once the first
             app covers it. The split and the apps' own orientations resize it, which it rides out rather than start the
             pair again. -->
        <activity
            android:name=".apps.SplitScreenActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- The system binds it only after the user grants notification access, and only the system may. -->
        <service
            android:name=".apps.UnreadListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
