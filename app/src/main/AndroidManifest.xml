<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Without it, the system ignores the uninstall request from an app's menu. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- The stock clock app guards the alarms screen, which the home clock opens, with this normal permission. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- A swipe down on the home page pulls the notification shade down with it. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Lists the launcher on the system's Do Not Disturb access screen, where the user grants the access the ringer switch
         needs. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Usage access for the Most Used card. The system grants it through its own settings screen, never at runtime,
         which is why lint's warning about a protected permission does not apply. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Orbit">

        <!-- The ring, the dock and the pages are laid out for a tall screen, as Arc's are; sideways, the ring shrinks to a
             thumbnail and the dock stretches across the screen. Android 16 ignores the lock on screens 600dp and wider,
             so a tablet still turns; a phone does not. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Not exported: MainActivity takes a pin request only through it, so no other app can hand the home screen one. -->
        <activity-alias
            android:name=".PinRequests"
            android:exported="false"
            android:targetActivity=".MainActivity" />

        <!-- The system starts it, and it alone may, whenever another app asks to pin a shortcut to the home screen, so
             that apps, Chrome's install among them, offer to. It has no window, task or place in recents of its own. -->
        <activity
            android:name=".PinShortcutActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>

        <!-- The system binds it only after the user grants notification access, and only the system may. -->
        <service
            android:name=".apps.UnreadListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
